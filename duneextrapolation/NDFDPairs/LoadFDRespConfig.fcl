BEGIN_PROLOG

LoadFDResp:
{
  module_type: "LoadFDResp"

  DigTickWindow: 4492 // Model usually predicts with window of 4492,
                      // simulation may expect 6000 sometimes?

  // Add fake noise to loaded FD response
  AddNoiseU:      false
  AddNoiseV:      false
  AddNoiseZ:      false
  NoiseH5FileLoc: ""

  NDFDH5FileLoc: ""
}

END_PROLOG
